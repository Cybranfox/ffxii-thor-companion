<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.thor.ffxiicompanion"
    android:versionCode="44"
    android:versionName="0.16.1-beta">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="33" />

    <!-- The live files are written by GameNative (Wine D: = /sdcard/Download), so reading them
         needs all-files access on Android 13. Grant once: appops set <pkg> MANAGE_EXTERNAL_STORAGE allow -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- 0.16.0: the setup screen's "Open GameNative" button. Android 11+ hides other apps unless they're named here. -->
    <queries>
        <package android:name="app.gamenative" />
    </queries>

    <application
        android:label="FFXII Companion"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
